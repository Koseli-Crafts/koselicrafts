---
interface Props {
	title: string;
	description: string;
	image: string;
	imageAlt: string;
}

const { title, description, image, imageAlt } = Astro.props;
---

<div class="product-card">
	<div class="product-image">
		<img src={image} alt={imageAlt} loading="lazy" />
		<div class="overlay"></div>
	</div>
	<div class="product-content">
		<h3>{title}</h3>
		<p>{description}</p>
		<a href="#" class="learn-more">View Details →</a>
	</div>
</div>

<style>
	.product-card {
		background: white;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 2px 8px rgba(58, 51, 42, 0.06), 0 4px 16px rgba(58, 51, 42, 0.08);
		transition: var(--transition);
		cursor: pointer;
		border: 1px solid rgba(232, 229, 225, 0.8);
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.product-card:hover {
		transform: translateY(-12px);
		box-shadow: 0 8px 24px rgba(58, 51, 42, 0.12), 0 16px 40px rgba(58, 51, 42, 0.08);
		border-color: rgba(212, 165, 116, 0.3);
	}

	.product-image {
		position: relative;
		width: 100%;
		padding-bottom: 100%;
		overflow: hidden;
		background: linear-gradient(135deg, #F0EBE6 0%, #E8E5E1 50%, #E0DCD7 100%);
	}

	.product-image img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}

	.product-card:hover .product-image img {
		transform: scale(1.08);
	}

	.overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(212, 165, 116, 0);
		transition: var(--transition);
	}

	.product-card:hover .overlay {
		background: rgba(107, 91, 71, 0.05);
	}

	.product-content {
		padding: 28px;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	h3 {
		font-size: 24px;
		font-weight: 700;
		margin-bottom: 12px;
		color: var(--color-dark);
		line-height: 1.2;
	}

	p {
		font-size: 15px;
		color: var(--color-light);
		margin-bottom: 20px;
		line-height: 1.7;
		flex: 1;
	}

	.learn-more {
		display: inline-block;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-gold);
		transition: var(--transition);
		padding: 4px 0;
		border-bottom: 2px solid transparent;
		width: fit-content;
	}

	.learn-more:hover {
		color: var(--color-wood);
		border-bottom-color: var(--color-gold);
		padding-left: 4px;
	}

	@media (max-width: 640px) {
		.product-card {
			border-radius: 12px;
		}

		.product-content {
			padding: 20px;
		}

		h3 {
			font-size: 20px;
		}

		p {
			font-size: 14px;
		}
	}
</style>
