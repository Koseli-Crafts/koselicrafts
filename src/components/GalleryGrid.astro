---
interface Props {
	images: {
		src: string;
		alt: string;
		title: string;
	}[];
	columns?: number;
}

const { images, columns = 3 } = Astro.props;
---

<div class="gallery-grid" style={`--columns: ${columns}`}>
	{images.map((image, index) => (
		<div class="gallery-item" data-item={index}>
			<div class="gallery-image-wrapper">
				<img src={image.src} alt={image.alt} loading="lazy" />
				<div class="gallery-overlay">
					<h4>{image.title}</h4>
				</div>
			</div>
		</div>
	))}
</div>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(var(--columns, 3), 1fr);
		gap: 24px;
		width: 100%;
	}

	.gallery-item {
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 12px;
		cursor: pointer;
		box-shadow: 0 4px 12px rgba(58, 51, 42, 0.08);
		transition: all 0.3s ease;
	}

	.gallery-item:hover {
		transform: translateY(-8px);
		box-shadow: 0 12px 32px rgba(58, 51, 42, 0.15);
	}

	.gallery-image-wrapper {
		position: relative;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, #f0ebe6 0%, #e8e5e1 100%);
	}

	.gallery-image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.gallery-item:hover .gallery-image-wrapper img {
		transform: scale(1.08);
	}

	.gallery-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(58, 51, 42, 0);
		display: flex;
		align-items: flex-end;
		padding: 20px;
		transition: background 0.3s ease;
	}

	.gallery-item:hover .gallery-overlay {
		background: rgba(58, 51, 42, 0.6);
	}

	.gallery-overlay h4 {
		color: white;
		margin: 0;
		font-size: 18px;
		font-weight: 700;
		opacity: 0;
		transition: opacity 0.3s ease;
		transform: translateY(10px);
	}

	.gallery-item:hover .gallery-overlay h4 {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 1024px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.gallery-grid {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.gallery-item {
			aspect-ratio: 4 / 3;
		}

		.gallery-overlay {
			padding: 16px;
		}

		.gallery-overlay h4 {
			font-size: 16px;
		}
	}
</style>
