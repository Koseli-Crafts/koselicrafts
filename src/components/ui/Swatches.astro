---
// Clickable color squares for an image. Place inside a `relative` container.
// Exactly one is selected: the image's own macramé color (the first one).
// Clicking another recolors the macramé (see the script in ProductCard.astro).
interface Props {
  colors: string[];
  groupKey: string;
  class?: string;
}
const { colors, groupKey, class: className = '' } = Astro.props;
---

{
  colors.length > 0 && (
    <ul
      class:list={['z-20 m-0 flex list-none gap-1.5 p-0', className]}
      role="radiogroup"
      aria-label="Macramé color"
      data-swatch-group={groupKey}
      data-source-color={colors[0]}
    >
      {colors.map((color, index) => (
        <li>
          <button
            type="button"
            role="radio"
            aria-checked={index === 0 ? 'true' : 'false'}
            aria-label={`Color ${color}`}
            title={color}
            data-swatch-color={color}
            class="block h-5 w-5 cursor-pointer rounded-[3px] border border-white/80 shadow-[0_1px_3px_rgba(0,0,0,0.35)] transition-transform hover:scale-110 aria-checked:scale-110 aria-checked:outline-2 aria-checked:outline-offset-2 aria-checked:outline-white aria-checked:ring-2 aria-checked:ring-pine sm:h-6 sm:w-6"
            style={`background:${color}`}
          />
        </li>
      ))}
    </ul>
  )
}
