---
interface Props {
	testimonials: {
		name: string;
		role: string;
		image: string;
		content: string;
		rating: number;
	}[];
}

const { testimonials } = Astro.props;
---

<div class="relative w-full">
	<div class="testimonial-track grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
		{testimonials.map((testimonial, index) => (
			<div class="testimonial-card scale-95 rounded-xl border border-spruce/20 bg-surface p-6 opacity-50 shadow-[0_2px_8px_rgba(17,33,19,0.06)] transition-all duration-300 md:p-8" data-testimonial={index}>
				<div class="mb-5 flex gap-4">
					<img src={testimonial.image} alt={testimonial.name} class="h-15 w-15 rounded-full border-2 border-patrol object-cover" />
					<div class="flex-1">
						<h4 class="mb-1 text-base font-semibold text-pine">{testimonial.name}</h4>
						<p class="mb-2 text-[0.8125rem] text-spruce">{testimonial.role}</p>
						<div class="flex gap-0.5">
							{[...Array(5)].map((_, i) => (
								<span class={i < testimonial.rating ? 'text-patrol' : 'text-spruce/40'}>★</span>
							))}
						</div>
					</div>
				</div>
				<p class="text-[0.95rem] leading-8 text-spruce italic">"{testimonial.content}"</p>
			</div>
		))}
	</div>

	<div class="mt-8 flex justify-center gap-3">
		<button class="carousel-btn prev flex h-11 w-11 items-center justify-center rounded-full bg-patrol text-xl text-white transition-all duration-300 hover:scale-110 hover:bg-pine" aria-label="Previous testimonial">←</button>
		<button class="carousel-btn next flex h-11 w-11 items-center justify-center rounded-full bg-patrol text-xl text-white transition-all duration-300 hover:scale-110 hover:bg-pine" aria-label="Next testimonial">→</button>
	</div>
</div>

<script>
	let currentTestimonial = 0;
	const cards = document.querySelectorAll('.testimonial-card');
	const totalCards = cards.length;
	const track = document.querySelector('.testimonial-track');

	function showTestimonial(n: number) {
		cards.forEach((card, index) => {
			card.classList.toggle('opacity-100', index === n);
			card.classList.toggle('scale-100', index === n);
			card.classList.toggle('border-patrol/70', index === n);
			card.classList.toggle('shadow-[0_10px_28px_rgba(212,37,30,0.12)]', index === n);

			if (index !== n) {
				card.classList.add('opacity-50', 'scale-95');
				card.classList.remove('border-patrol/70', 'shadow-[0_10px_28px_rgba(212,37,30,0.12)]');
			} else {
				card.classList.remove('opacity-50', 'scale-95');
			}
		});
	}

	function nextTestimonial() {
		currentTestimonial = (currentTestimonial + 1) % totalCards;
		showTestimonial(currentTestimonial);
	}

	function prevTestimonial() {
		currentTestimonial = (currentTestimonial - 1 + totalCards) % totalCards;
		showTestimonial(currentTestimonial);
	}

	document.querySelector('.carousel-btn.prev')?.addEventListener('click', prevTestimonial);
	document.querySelector('.carousel-btn.next')?.addEventListener('click', nextTestimonial);

	showTestimonial(0);
</script>
