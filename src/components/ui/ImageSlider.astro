---
interface Props {
	images: { src: string; alt: string; title: string }[];
	autoPlay?: boolean;
	interval?: number;
}

const { images, autoPlay = true, interval = 5000 } = Astro.props;
---

<div class="relative w-full max-w-full">
	<div class="relative aspect-4/3 w-full overflow-hidden rounded-xl sm:aspect-video sm:rounded-2xl">
		<div class="relative h-full w-full">
			{images.map((image, index) => (
				<div class="slide absolute inset-0 flex h-full w-full items-center justify-center bg-spruce/15 opacity-0 transition-opacity duration-700" data-slide={index}>
					<img src={image.src} alt={image.alt} class="h-full w-full object-cover" />
					{image.title && <div class="absolute bottom-4 left-4 font-display text-xl font-semibold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.4)] sm:bottom-6 sm:left-6 sm:text-[1.75rem]">{image.title}</div>}
				</div>
			))}
		</div>
	</div>

	<button class="slider-btn prev absolute top-1/2 left-2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-patrol/90 text-xl text-white transition-all duration-300 hover:scale-110 hover:bg-pine sm:left-4 sm:h-12 sm:w-12 sm:text-2xl" aria-label="Previous slide">←</button>
	<button class="slider-btn next absolute top-1/2 right-2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-patrol/90 text-xl text-white transition-all duration-300 hover:scale-110 hover:bg-pine sm:right-4 sm:h-12 sm:w-12 sm:text-2xl" aria-label="Next slide">→</button>

	<div class="mt-5 flex justify-center gap-3 px-4">
		{images.map((_, index) => (
			<button class="dot h-3 w-3 cursor-pointer rounded-full border-2 border-patrol bg-spruce/15 transition-all duration-300 hover:bg-patrol" data-dot={index} aria-label={`Go to slide ${index + 1}`}></button>
		))}
	</div>
</div>

<script define:vars={{ autoPlay, interval, imageCount: images.length }}>
	let currentSlide = 0;
	const totalSlides = imageCount;
	let autoPlayInterval;

	const slides = document.querySelectorAll('.slide');
	const dots = document.querySelectorAll('.dot');
	const prevBtn = document.querySelector('.slider-btn.prev');
	const nextBtn = document.querySelector('.slider-btn.next');

	function showSlide(n) {
		slides.forEach(slide => slide.classList.remove('opacity-100', 'z-10'));
		dots.forEach(dot => dot.classList.remove('bg-patrol', 'scale-125'));

		slides[n].classList.add('opacity-100', 'z-10');
		dots[n].classList.add('bg-patrol', 'scale-125');
	}

	function nextSlide() {
		currentSlide = (currentSlide + 1) % totalSlides;
		showSlide(currentSlide);
		if (autoPlay) resetAutoPlay();
	}

	function prevSlide() {
		currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
		showSlide(currentSlide);
		if (autoPlay) resetAutoPlay();
	}

	function goToSlide(n) {
		currentSlide = n;
		showSlide(currentSlide);
		if (autoPlay) resetAutoPlay();
	}

	function resetAutoPlay() {
		if (autoPlayInterval) clearInterval(autoPlayInterval);
		if (autoPlay) {
			autoPlayInterval = setInterval(nextSlide, interval);
		}
	}

	prevBtn?.addEventListener('click', prevSlide);
	nextBtn?.addEventListener('click', nextSlide);

	dots.forEach((dot, index) => {
		dot.addEventListener('click', () => goToSlide(index));
	});

	showSlide(0);
	if (autoPlay) {
		autoPlayInterval = setInterval(nextSlide, interval);
	}
</script>
