---
interface Props {
	title: string;
	description: string;
	image: string;
	imageAlt: string;
}

const { title, description, image, imageAlt } = Astro.props;
---

<div class="group flex h-full cursor-pointer flex-col overflow-hidden rounded-xl border border-spruce/20 bg-surface shadow-[0_2px_8px_rgba(17,33,19,0.06),0_4px_16px_rgba(17,33,19,0.08)] transition-all duration-300 hover:-translate-y-2 hover:border-patrol/35 hover:shadow-[0_10px_26px_rgba(17,33,19,0.14),0_18px_42px_rgba(17,33,19,0.1)] sm:rounded-2xl">
	<div class="relative w-full overflow-hidden bg-spruce/10 pb-[100%]">
		<img src={image} alt={imageAlt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-110" />
		<div class="absolute inset-0 bg-patrol/0 transition-colors duration-300 group-hover:bg-pine/10"></div>
	</div>
	<div class="flex flex-1 flex-col p-5 sm:p-7">
		<h3 class="mb-3 text-[1.25rem] leading-tight font-semibold tracking-tight text-pine sm:text-[1.5rem]">{title}</h3>
		<p class="mb-5 flex-1 text-sm leading-7 text-spruce sm:text-[0.95rem]">{description}</p>
		<a href="#" class="inline-block w-fit border-b-2 border-transparent py-1 text-sm font-semibold text-patrol transition-all duration-300 hover:border-patrol hover:pl-1 hover:text-pine">View Details →</a>
	</div>
</div>
