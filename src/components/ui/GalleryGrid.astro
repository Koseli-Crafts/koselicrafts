---
interface Props {
	images: {
		src: string;
		alt: string;
		title: string;
	}[];
	columns?: number;
}

const { images, columns = 3 } = Astro.props;
---

<div
	class:list={[
		'grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6',
		columns === 1 && 'lg:grid-cols-1',
		columns === 2 && 'lg:grid-cols-2',
		columns === 3 && 'lg:grid-cols-3',
		columns === 4 && 'lg:grid-cols-4'
	]}
>
	{images.map((image, index) => (
		<div class="group aspect-4/3 cursor-pointer overflow-hidden rounded-xl shadow-[0_4px_12px_rgba(17,33,19,0.08)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_12px_32px_rgba(17,33,19,0.18)] md:aspect-square" data-item={index}>
			<div class="relative h-full w-full bg-spruce/10">
				<img src={image.src} alt={image.alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110" />
				<div class="absolute inset-0 flex items-end bg-pine/0 p-4 transition-colors duration-300 group-hover:bg-pine/70 sm:p-5">
					<h4 class="translate-y-2 text-base font-semibold text-white opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 sm:text-lg">{image.title}</h4>
				</div>
			</div>
		</div>
	))}
</div>
