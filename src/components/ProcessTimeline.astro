---
interface Props {
	steps: {
		icon: string;
		title: string;
		description: string;
	}[];
}

const { steps } = Astro.props;
---

<div class="process-timeline">
	<div class="timeline-track">
		{steps.map((step, index) => (
			<div class="timeline-item" data-step={index}>
				<div class="timeline-dot">
					<div class="icon-placeholder">{step.icon}</div>
					{index < steps.length - 1 && <div class="timeline-line"></div>}
				</div>
				<div class="timeline-content">
					<h4>{step.title}</h4>
					<p>{step.description}</p>
				</div>
			</div>
		))}
	</div>
</div>

<style>
	.process-timeline {
		position: relative;
		width: 100%;
		padding: 20px 0;
	}

	.timeline-track {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 32px;
		position: relative;
	}

	.timeline-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.timeline-dot {
		position: relative;
		display: flex;
		align-items: center;
	}

	.icon-placeholder {
		width: 80px;
		height: 80px;
		background: linear-gradient(135deg, var(--color-gold) 0%, rgba(212, 165, 116, 0.7) 100%);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 40px;
		color: white;
		font-weight: 700;
		box-shadow: 0 8px 24px rgba(212, 165, 116, 0.3);
		transition: all 0.3s ease;
	}

	.timeline-item:hover .icon-placeholder {
		transform: scale(1.1);
		box-shadow: 0 12px 32px rgba(212, 165, 116, 0.4);
	}

	.timeline-line {
		position: absolute;
		left: 92px;
		top: 40px;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, var(--color-gold) 0%, transparent 100%);
		transform: translateX(32px);
	}

	.timeline-content {
		flex: 1;
	}

	.timeline-content h4 {
		font-size: 18px;
		font-weight: 700;
		color: var(--color-wood);
		margin: 0 0 8px 0;
	}

	.timeline-content p {
		font-size: 14px;
		color: var(--color-light);
		margin: 0;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.timeline-track {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.timeline-line {
			display: none;
		}

		.icon-placeholder {
			width: 70px;
			height: 70px;
			font-size: 32px;
		}
	}

	@media (max-width: 480px) {
		.icon-placeholder {
			width: 60px;
			height: 60px;
			font-size: 28px;
		}

		.timeline-content h4 {
			font-size: 16px;
		}

		.timeline-content p {
			font-size: 13px;
		}
	}
</style>
