---
import TestimonialCarousel from '../ui/TestimonialCarousel.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  testimonials: {
    name: string;
    role: string;
    image: string;
    content: string;
    rating: number;
  }[];
}

const { testimonials } = Astro.props;
---

<section id="testimonials" class="content-section" data-aos="fade-up">
  <SectionHeader title="What Our Customers Say" subtitle="Real feedback from recent clients" />
  <TestimonialCarousel testimonials={testimonials} />
</section>
