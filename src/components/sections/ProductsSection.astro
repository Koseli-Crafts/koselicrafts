---
import ProductCard from '../ui/ProductCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import productsData from '../../data/products.json';
import prd1 from '../../assets/prd1.jpg';
import prd2 from '../../assets/prd2.jpg';
import prd3 from '../../assets/prd3.jpg';
import prd4 from '../../assets/prd4.jpg';
import prd5 from '../../assets/prd5.jpeg';

interface ProductEntry {
  sku: keyof typeof imageAssetMap;
  title: string;
  description: string;
  price?: number;
  gallery: ProductImageEntry[];
}

interface ProductImageEntry {
  asset: keyof typeof imageAssetMap;
  alt: string;
  title: string;
}

const imageAssetMap = {
  'prd1': prd1.src,
  'prd2': prd2.src,
  'prd3': prd3.src,
  'prd4': prd4.src,
  'prd5': prd5.src
} as const;

const products = productsData as ProductEntry[];
---

<section id="products" class="content-section" data-aos="fade-up">
  <SectionHeader title="Our Collection" subtitle="Tap any piece to view it in full screen" />
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
    {products.map((product, index) => {
      const galleryImages = product.gallery
        .map((galleryItem) => ({
          src: imageAssetMap[galleryItem.asset],
          alt: galleryItem.alt,
          title: galleryItem.title
        }));

      if (!galleryImages.length) return null;

      return (
        <ProductCard
          title={product.title}
          description={product.description}
          price={product.price}
          image={galleryImages[0].src}
          imageAlt={galleryImages[0].alt}
          galleryImages={galleryImages}
          delay={Math.min(index * 70, 420)}
        />
      );
    })}
  </div>
</section>
