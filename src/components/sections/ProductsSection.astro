---
import ProductCard from '../ui/ProductCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import productsData from '../../data/products.json';

interface ProductEntry {
  title: string;
  description: string;
  price?: number | string;
  images: string[];
}

// Every file in src/assets/products/ is picked up automatically — drop an image
// in that folder and reference it by filename in src/data/products.json.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/products/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const imagesByFilename = Object.fromEntries(
  Object.entries(imageModules).map(([path, mod]) => [path.split('/').pop()!, mod.default.src])
);

const products = productsData as ProductEntry[];

for (const product of products) {
  for (const filename of product.images) {
    if (!imagesByFilename[filename]) {
      throw new Error(
        `Product "${product.title}" refers to the image "${filename}", but that file is not in src/assets/products/.\n` +
        `Available images: ${Object.keys(imagesByFilename).join(', ')}`
      );
    }
  }
}
---

<section id="products" class="content-section" data-aos="fade-up">
  <SectionHeader title="Our Collection" subtitle="Tap any piece to view it in full screen" />
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
    {products.map((product, index) => {
      const galleryImages = product.images.map((filename) => ({
        src: imagesByFilename[filename],
        alt: product.title
      }));

      if (!galleryImages.length) return null;

      return (
        <ProductCard
          title={product.title}
          description={product.description}
          price={product.price}
          image={galleryImages[0].src}
          imageAlt={galleryImages[0].alt}
          galleryImages={galleryImages}
          delay={Math.min(index * 70, 420)}
        />
      );
    })}
  </div>
</section>
