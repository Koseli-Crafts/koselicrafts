---
import ProductCard from '../ui/ProductCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  images: { src: string; alt: string; title: string }[];
}

const { images } = Astro.props;

const products = [
  {
    title: 'Signature Display Collection',
    description: 'Elegant focal pieces for styled interiors.',
    gallery: [0, 4, 6]
  },
  {
    title: 'Refined Plaque Series',
    description: 'Warm wood and engraved detail.',
    gallery: [2, 8, 1]
  },
  {
    title: 'Custom Detail Line',
    description: 'Warm tones with personalized finishing.',
    gallery: [1, 5, 7]
  },
  {
    title: 'Modern Accent Studio',
    description: 'Minimal styling for calm spaces.',
    gallery: [3, 6, 4]
  },
  {
    title: 'Custom Signature Set',
    description: 'Personalized names, wording, and milestones.',
    gallery: [5, 0, 8]
  },
  {
    title: 'Heirloom Wall Pieces',
    description: 'Built for statement display.',
    gallery: [6, 2, 4]
  }
];
---

<section id="products" class="content-section" data-aos="fade-up">
  <SectionHeader title="Our Collection" subtitle="Tap any piece to view it in full screen" />
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
    {products.map((product, index) => {
      const galleryImages = product.gallery.map((imageIndex) => images[imageIndex % images.length]);
      return (
        <ProductCard
          title={product.title}
          description={product.description}
          image={galleryImages[0].src}
          imageAlt={galleryImages[0].alt}
          galleryImages={galleryImages}
          delay={Math.min(index * 70, 420)}
        />
      );
    })}
  </div>
</section>
