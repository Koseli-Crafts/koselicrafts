---
import ProductCard from '../ui/ProductCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { getPalette } from '../../lib/palette';
import productsData from '../../data/products.json';

interface ProductEntry {
  title: string;
  description: string;
  price?: number | string;
  images: string[];
  swatches?: boolean;
}

// Every file in src/assets/products/ is picked up automatically — drop an image
// in that folder and reference it in src/data/products.json. Entries may be a
// bare filename ("clock.jpg") or a path ("/products/clock.jpg", which is what
// Pages CMS writes); only the filename is used to look the image up.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/products/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const imagesByFilename = Object.fromEntries(
  Object.entries(imageModules).map(([path, mod]) => [path.split('/').pop()!, mod.default.src])
);

const basename = (imageRef: string) => imageRef.split('/').pop()!;

const products = productsData as ProductEntry[];

// Bright colors offered on top of each photo's own macramé colors.
const PRESET_COLORS = ['#22c55e', '#1e88e5', '#e53935', '#ec4899', '#8b5cf6'];

const rgbOf = (hex: string) => [1, 3, 5].map((i) => Number.parseInt(hex.slice(i, i + 2), 16));
const farFrom = (hex: string, others: string[]) =>
  others.every((o) => Math.hypot(...rgbOf(hex).map((v, i) => v - rgbOf(o)[i])) > 90);

const withPresets = (own: string[]) =>
  own.length ? [...own, ...PRESET_COLORS.filter((c) => farFrom(c, own))] : own;

const paletteByFilename: Record<string, string[]> = {};
await Promise.all(
  Object.keys(imagesByFilename).map(async (name) => {
    paletteByFilename[name] = await getPalette(`products/${name}`);
  })
);

for (const product of products) {
  for (const imageRef of product.images) {
    if (!imagesByFilename[basename(imageRef)]) {
      throw new Error(
        `Product "${product.title}" refers to the image "${imageRef}", but that file is not in src/assets/products/.\n` +
        `Available images: ${Object.keys(imagesByFilename).join(', ')}`
      );
    }
  }
}
---

<section id="products" class="content-section" data-aos="fade-up">
  <SectionHeader title="The collection" subtitle="Tap a piece to see it up close, then order it on WhatsApp." />
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
    {products.map((product, index) => {
      const galleryImages = product.images.map((imageRef) => ({
        src: imagesByFilename[basename(imageRef)],
        alt: product.title,
        colors: product.swatches ? withPresets(paletteByFilename[basename(imageRef)]) : []
      }));

      if (!galleryImages.length) return null;

      return (
        <ProductCard
          title={product.title}
          description={product.description}
          price={product.price}
          image={galleryImages[0].src}
          imageAlt={galleryImages[0].alt}
          galleryImages={galleryImages}
          delay={Math.min(index * 70, 420)}
        />
      );
    })}
  </div>
</section>
