---
import ProductCard from '../ui/ProductCard.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import productsData from '../../data/products.json';
import productFaithInspiration from '../../assets/product-faith-inspiration.jpg';
import productDivineLove from '../../assets/product-divine-love.jpg';
import productGracePlaque from '../../assets/product-grace-plaque.jpg';
import productInnerPeace from '../../assets/product-inner-peace.jpg';
import galleryFaithSeries from '../../assets/gallery-faith-series.jpg';
import galleryCustomOrders from '../../assets/gallery-custom-orders.jpg';
import galleryPremiumRange from '../../assets/gallery-premium-range.jpg';
import gallerySpecialEditions from '../../assets/gallery-special-editions.jpg';
import galleryGiftSets from '../../assets/gallery-gift-sets.jpg';

interface ProductEntry {
  title: string;
  description: string;
  gallery: ProductImageEntry[];
}

interface ProductImageEntry {
  asset: keyof typeof imageAssetMap;
  alt: string;
  title: string;
}

const imageAssetMap = {
  'product-faith-inspiration': productFaithInspiration.src,
  'product-divine-love': productDivineLove.src,
  'product-grace-plaque': productGracePlaque.src,
  'product-inner-peace': productInnerPeace.src,
  'gallery-faith-series': galleryFaithSeries.src,
  'gallery-custom-orders': galleryCustomOrders.src,
  'gallery-premium-range': galleryPremiumRange.src,
  'gallery-special-editions': gallerySpecialEditions.src,
  'gallery-gift-sets': galleryGiftSets.src
} as const;

const products = productsData as ProductEntry[];
---

<section id="products" class="content-section" data-aos="fade-up">
  <SectionHeader title="Our Collection" subtitle="Tap any piece to view it in full screen" />
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
    {products.map((product, index) => {
      const galleryImages = product.gallery
        .map((galleryItem) => ({
          src: imageAssetMap[galleryItem.asset],
          alt: galleryItem.alt,
          title: galleryItem.title
        }));

      if (!galleryImages.length) return null;

      return (
        <ProductCard
          title={product.title}
          description={product.description}
          image={galleryImages[0].src}
          imageAlt={galleryImages[0].alt}
          galleryImages={galleryImages}
          delay={Math.min(index * 70, 420)}
        />
      );
    })}
  </div>
</section>
