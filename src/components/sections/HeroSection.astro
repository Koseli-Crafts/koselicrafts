---
import logo from '../../assets/KoseliCrafts_logo.png';
import TagButton from '../ui/TagButton.astro';
import PhoneMenu from '../ui/PhoneMenu.astro';
import FloatingPieces, { type FloatSlot } from '../ui/FloatingPieces.astro';
import { FIRST_THEME, THEMES } from '../../data/themes';
import { ORDER_LINK } from '../../lib/contact';
import { RESOURCES_PAGE } from '../../lib/resources';
import { heroWordSize, padNumber } from '../../lib/format';

// Layer 3 sits behind the hanging piece (layer 5), layer 8 in front of it.
const LOOSE_PIECES: FloatSlot[] = [
  { left: '12%', top: '18%', size: 120, depth: 0.5, kind: 'tassel', rotate: -18 },
  { left: '74%', top: '14%', size: 96, depth: 0.7, kind: 'wood-0', rotate: 14 },
  { left: '27%', top: '66%', size: 84, depth: 0.9, kind: 'wood-1', rotate: -10, hideWhenNarrow: true },
  { left: '70%', top: '60%', size: 130, depth: 0.6, kind: 'tassel', rotate: 22, hideWhenNarrow: true },
  { left: '44%', top: '8%', size: 56, depth: 1.2, kind: 'wood-2', rotate: 30, blur: 1.5 },
  { left: '2%', top: '64%', size: 230, depth: -1.8, kind: 'tassel', rotate: 28, blur: 9, layer: 8, hideWhenNarrow: true },
  { left: '84%', top: '6%', size: 170, depth: -1.5, kind: 'wood-0', rotate: -20, blur: 8, layer: 8 },
  { left: '88%', top: '46%', size: 90, depth: -1, kind: 'wood-2', rotate: 8, layer: 8 }
];

const MENU_LINKS = [
  { href: '#collection', label: 'Shop' },
  { href: '#made', label: 'Our craft' },
  { href: '#questions', label: 'Questions' },
  { href: RESOURCES_PAGE, label: 'Resources' }
];

// Softer and warmer than elsewhere, so pieces sit on the bright theme colour.
const HERO_SHADOW = 'rgba(43,33,24,0.22)';
---

<section id="top" class="hero is-playing" data-hero data-parallax data-dir="1">
  <script type="application/json" id="koseli-themes" set:html={JSON.stringify(THEMES)} />
  <div class="hero-previous" aria-hidden="true"></div>
  <div class="hero-wipe" aria-hidden="true"></div>

  <header class="hero-head">
    <a href="#top" class="plaque" aria-label="Koseli Crafts, back to the top">
      <span class="plaque-cords" aria-hidden="true"><span></span><span></span></span>
      <span class="plaque-card"><img src={logo.src} alt="Koseli Crafts" /></span>
    </a>
    <nav class="garland" aria-label="Themes">
      {THEMES.map((theme, index) => (
        <button type="button" data-theme-index={index} aria-pressed={index === 0 ? 'true' : 'false'}>{theme.nav}</button>
      ))}
    </nav>
    <nav class="main-nav" aria-label="Main">
      <a href="#collection" class="wavy-link main-nav-link">Shop</a>
      <a href="#made" class="wavy-link main-nav-link hide-below-900">Our craft</a>
      <a href="#questions" class="wavy-link main-nav-link hide-below-900">Questions</a>
      <a href={RESOURCES_PAGE} class="wavy-link main-nav-link hide-below-900">Resources</a>
      <PhoneMenu links={MENU_LINKS} />
      <a href={ORDER_LINK} target="_blank" rel="noopener" class="order-badge" aria-label="Order on WhatsApp">
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <defs><path id="order-badge-ring" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"></path></defs>
          <text><textPath href="#order-badge-ring">Order on WhatsApp · कोसेली ·</textPath></text>
        </svg>
        <span class="order-badge-core" aria-hidden="true">↗</span>
      </a>
    </nav>
  </header>

  <div class="hero-word-wrap" aria-hidden="true">
    <p class="hero-word" data-hero-word style={{ fontSize: heroWordSize(FIRST_THEME.word) }}>{FIRST_THEME.word}</p>
  </div>

  <FloatingPieces slots={LOOSE_PIECES} pop shadowColor={HERO_SHADOW} bobStagger={0.9} />

  <div class="hero-piece follows-pointer" style={{ '--shift-x': '-14px', '--shift-y': '-8px' }}>
    <div class="hero-piece-hook" data-hero-hook style={{ top: FIRST_THEME.top }}>
      <div class="hero-hang">
        <div class="sway hero-piece-sway">
          <span class="hero-cord" data-hero-cord aria-hidden="true" style={{ height: `${FIRST_THEME.cordLength}px` }}></span>
          <img
            class="hero-img"
            data-hero-image
            draggable="false"
            src={FIRST_THEME.image}
            alt={FIRST_THEME.imageAlt}
            style={{ height: `min(${FIRST_THEME.imageHeight}px, 64vh)` }}
          />
        </div>
      </div>
      <div class="hero-shadow" aria-hidden="true"></div>
    </div>
  </div>

  <div class="hero-copy hero-fade">
    <span class="hero-kicker" data-hero-kicker>01 · {FIRST_THEME.kicker}</span>
    <h1 data-hero-line>{FIRST_THEME.line}</h1>
  </div>

  <div class="hero-foot">
    <button type="button" class="bead" data-hero-step="-1" aria-label="Previous theme">←</button>
    <TagButton href="#collection" label={FIRST_THEME.cta} arrow="down" data-hero-cta />
    <div class="hero-foot-end">
      <span class="hero-count hide-below-900" data-hero-count>01 / {padNumber(THEMES.length)}</span>
      <button type="button" class="bead bead--small" data-hero-pause aria-pressed="false" aria-label="Pause the theme slideshow">
        <svg class="pause-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="1"></rect><rect x="9.5" y="2.5" width="3" height="11" rx="1"></rect></svg>
        <svg class="play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.3-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5z"></path></svg>
      </button>
      <button type="button" class="bead" data-hero-step="1" aria-label="Next theme">→</button>
    </div>
  </div>

  <div class="hero-progress" aria-hidden="true">
    <div data-hero-progress style={{ width: `${(100 / THEMES.length).toFixed(1)}%` }}></div>
  </div>
</section>

<script>
  import { heroWordSize, padNumber } from '../../lib/format';
  import { paintTheme, readThemes, showThemeInCollection } from '../../scripts/theme';

  const AUTOPLAY_EVERY_MS = 5500;
  const PAUSE_AFTER_TOUCH_MS = 9000;

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const themes = readThemes();
  const find = <T extends HTMLElement>(selector: string) => hero.querySelector<T>(selector)!;

  const word = find('[data-hero-word]');
  const hook = find('[data-hero-hook]');
  const cord = find('[data-hero-cord]');
  const image = find<HTMLImageElement>('[data-hero-image]');
  const kicker = find('[data-hero-kicker]');
  const line = find('[data-hero-line]');
  const cta = find('[data-hero-cta]');
  const ctaLabel = find('[data-hero-cta] [data-tag-label]');
  const count = find('[data-hero-count]');
  const progress = find('[data-hero-progress]');
  const themeButtons = hero.querySelectorAll<HTMLButtonElement>('[data-theme-index]');
  const pauseButton = find<HTMLButtonElement>('[data-hero-pause]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let current = 0;
  let lastTouch = 0;
  let heroInView = true;
  let focusInside = false;
  let paused = reduceMotion.matches;

  function replayAnimations() {
    hero.classList.remove('is-playing');
    void hero.offsetWidth;
    hero.classList.add('is-playing');
  }

  function show(index: number, direction: 1 | -1) {
    const next = (index + themes.length) % themes.length;
    if (next === current) return;
    hero.style.setProperty('--previous-bg', themes[current].background);
    hero.dataset.dir = String(direction);
    current = next;
    const theme = themes[next];

    paintTheme(theme);
    word.textContent = theme.word;
    word.style.fontSize = heroWordSize(theme.word);
    hook.style.top = theme.top;
    cord.style.height = `${theme.cordLength}px`;
    image.src = theme.image;
    image.alt = theme.imageAlt;
    image.style.height = `min(${theme.imageHeight}px, 64vh)`;
    kicker.textContent = `${padNumber(next + 1)} · ${theme.kicker}`;
    line.textContent = theme.line;
    ctaLabel.textContent = theme.cta;
    count.textContent = `${padNumber(next + 1)} / ${padNumber(themes.length)}`;
    progress.style.width = `${(((next + 1) / themes.length) * 100).toFixed(1)}%`;
    themeButtons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === next)));
    replayAnimations();
  }

  const markTouched = () => { lastTouch = Date.now(); };

  function setPaused(value: boolean) {
    paused = value;
    pauseButton.setAttribute('aria-pressed', String(paused));
  }

  setPaused(paused);
  pauseButton.addEventListener('click', () => setPaused(!paused));

  // Any use of the hero, by pointer or keyboard, holds the slideshow for a while,
  // and it never moves on while keyboard focus is inside it.
  hero.addEventListener('pointerdown', markTouched);
  hero.addEventListener('keydown', markTouched);
  // Scrolling the page counts as use too, so the hero holds still while
  // people scroll past or back up to it.
  window.addEventListener('scroll', markTouched, { passive: true });
  hero.addEventListener('focusin', () => { focusInside = true; });
  hero.addEventListener('focusout', (event) => {
    focusInside = hero.contains(event.relatedTarget as Node | null);
  });

  hero.querySelectorAll<HTMLButtonElement>('[data-hero-step]').forEach((button) => {
    button.addEventListener('click', () => {
      markTouched();
      const step = Number(button.dataset.heroStep) as 1 | -1;
      show(current + step, step);
    });
  });
  themeButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      markTouched();
      show(index, index > current ? 1 : -1);
    });
  });
  cta.addEventListener('click', () => {
    markTouched();
    showThemeInCollection(themes[current].id);
  });

  // Swipe left or right anywhere in the hero to change theme; the theme tabs keep
  // their own sideways scroll. A quick flick counts as much as a long drag.
  const SWIPE_DISTANCE = 40;
  const SWIPE_SPEED = 0.11; // px per ms
  const TAP_TOLERANCE = 10;
  let swipe: { id: number; x: number; y: number; time: number } | null = null;
  let swallowNextClick = false;

  hero.addEventListener('pointerdown', (event) => {
    swallowNextClick = false;
    if (!event.isPrimary || (event.target as Element).closest('.garland')) return;
    swipe = { id: event.pointerId, x: event.clientX, y: event.clientY, time: event.timeStamp };
  });

  hero.addEventListener('pointerup', (event) => {
    if (!swipe || event.pointerId !== swipe.id) return;
    const dx = event.clientX - swipe.x;
    const dy = event.clientY - swipe.y;
    const speed = Math.abs(dx) / Math.max(1, event.timeStamp - swipe.time);
    swipe = null;
    const sideways = Math.abs(dx) > TAP_TOLERANCE && Math.abs(dx) > Math.abs(dy);
    if (!sideways || (Math.abs(dx) <= SWIPE_DISTANCE && speed <= SWIPE_SPEED)) return;
    // A swipe that ends on the button or a link must not also press it.
    swallowNextClick = true;
    const step = dx < 0 ? 1 : -1;
    show(current + step, step);
  });

  hero.addEventListener('pointercancel', () => { swipe = null; });

  hero.addEventListener('click', (event) => {
    if (!swallowNextClick) return;
    swallowNextClick = false;
    event.preventDefault();
    event.stopPropagation();
  }, true);

  // Only cycle while the hero is on screen, so the page below doesn't keep
  // changing colour while people read it.
  new IntersectionObserver(([entry]) => { heroInView = entry.isIntersecting; }, { threshold: 0.35 }).observe(hero);

  setInterval(() => {
    if (paused || reduceMotion.matches || focusInside || !heroInView || document.hidden) return;
    if (Date.now() - lastTouch > PAUSE_AFTER_TOUCH_MS) show(current + 1, 1);
  }, AUTOPLAY_EVERY_MS);
</script>

<style>
  .hero {
    --dir: 1;
    position: relative;
    /* Sideways swipes come to the page script; vertical scrolling stays with the browser. */
    touch-action: pan-y;
    height: max(100vh, 820px);
    overflow: hidden;
  }

  .hero[data-dir='-1'] {
    --dir: -1;
  }

  .hero-previous,
  .hero-wipe {
    position: absolute;
    inset: 0;
  }

  .hero-previous {
    background: var(--previous-bg, var(--theme-bg));
  }

  .hero-wipe {
    background: var(--theme-bg);
  }

  /* ---------- Header: a hanging logo plaque, a garland of themes, the main links ---------- */
  .hero-head {
    position: absolute;
    z-index: 20;
    inset: 0 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  /* An open menu dims the page, so it has to sit above the hero text and buttons. */
  .hero-head:has([data-phone-menu][data-open='true']) {
    z-index: 30;
  }

  .plaque {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transform-origin: 50% 0;
    animation: sway 6s ease-in-out infinite;
  }

  .plaque-cords {
    display: flex;
    justify-content: space-between;
    width: 64%;
    height: 28px;
  }

  .plaque-cords span {
    width: 2px;
    height: 100%;
    background: var(--color-ink);
  }

  .plaque-card {
    position: relative;
    background: var(--color-paper);
    padding: 16px 22px 14px;
    border-radius: 14px;
    box-shadow: 0 16px 30px rgb(43 33 24 / 0.24);
  }

  .plaque-card::before,
  .plaque-card::after {
    content: '';
    position: absolute;
    top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-ink);
  }

  .plaque-card::before { left: 18%; }
  .plaque-card::after { right: 18%; }

  .plaque-card img {
    display: block;
    height: 38px;
    width: auto;
  }

  .garland {
    position: relative;
    display: flex;
    gap: 12px;
  }

  .garland::before {
    content: '';
    position: absolute;
    left: -36px;
    right: -36px;
    top: 20px;
    height: 2px;
    background: var(--color-ink);
  }

  .garland button {
    position: relative;
    margin-top: 36px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 16px 15px 9px;
    border: 0;
    border-radius: 5px 5px 14px 14px;
    background: rgb(255 255 255 / 0.75);
    color: var(--color-ink);
    font: 600 14px var(--font-body);
    cursor: pointer;
    transform-origin: 50% -16px;
    box-shadow: 0 8px 16px rgb(43 33 24 / 0.14);
    transition: transform 0.55s cubic-bezier(0.3, 1.6, 0.5, 1), background 0.3s, color 0.3s;
  }

  .garland button::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -16px;
    width: 2px;
    height: 20px;
    margin-left: -1px;
    background: var(--color-ink);
  }

  .garland button::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 5px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: rgb(43 33 24 / 0.55);
  }

  .garland button:active {
    transform: scale(0.97);
    transition: transform 160ms var(--motion-out), background 0.3s, color 0.3s;
  }

  @media (hover: hover) and (pointer: fine) {
    .garland button:hover {
      transform: rotate(7deg);
    }

    .garland button:hover:active {
      transform: rotate(7deg) scale(0.97);
    }
  }

  .garland button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .garland button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .garland button[aria-pressed='true']::after {
    background: rgb(247 241 232 / 0.7);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    padding-top: 22px;
  }

  .main-nav-link {
    padding: 12px 0;
    font: 700 15px var(--font-body);
  }

  .order-badge {
    position: relative;
    display: block;
    width: 98px;
    height: 98px;
    color: var(--color-bead-ink);
    border-radius: 50%;
    background: var(--wood-disc) center / 140% no-repeat;
    box-shadow: inset 0 0 0 2.5px #5e3519, inset 0 0 8px rgb(70 35 12 / 0.45), 0 10px 18px rgb(43 33 24 / 0.28);
  }

  .order-badge svg {
    display: block;
    width: 100%;
    height: 100%;
    animation: badge-spin 18s linear infinite;
  }

  .order-badge text {
    fill: var(--color-bead-ink);
    font: 800 10px var(--font-body);
    letter-spacing: 2.2px;
    text-transform: uppercase;
  }

  .order-badge-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 50px;
    height: 50px;
    margin: -25px 0 0 -25px;
    border-radius: 50%;
    border: 1.5px solid rgb(58 31 13 / 0.85);
    box-shadow: 0 0 3px rgb(120 62 24 / 0.35);
    text-shadow: 0 0 1px rgb(58 31 13 / 0.9), 0 0 3px rgb(120 62 24 / 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font: 300 24px var(--font-body);
    transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .order-badge:hover .order-badge-core {
    transform: scale(1.12) rotate(-45deg);
  }

  .order-badge:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 4px;
  }

  @keyframes badge-spin {
    to { transform: rotate(360deg); }
  }

  /* ---------- The theme: big word, hanging piece, copy ---------- */
  .hero-word-wrap {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .hero-word {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    color: #fff;
    white-space: nowrap;
  }

  .hero-piece {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 0;
    display: flex;
    justify-content: center;
  }

  .hero-piece-hook {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-hang {
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
  }

  .hero-piece-sway {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-cord {
    display: block;
    width: 2px;
    background: rgb(43 33 24 / 0.55);
  }

  .hero-img {
    display: block;
    width: auto;
    max-width: 44vw;
    object-fit: contain;
    filter: drop-shadow(0 40px 40px rgb(43 33 24 / 0.25));
  }

  .hero-shadow {
    width: 300px;
    height: 34px;
    margin-top: 18px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(43 33 24 / 0.45), rgb(43 33 24 / 0));
    animation: hero-shadow 5s ease-in-out infinite;
  }

  .hero-copy {
    position: absolute;
    z-index: 20;
    left: 44px;
    top: 50%;
    transform: translateY(-50%);
    max-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero-kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .hero-foot {
    position: absolute;
    z-index: 20;
    inset: auto 0 0;
    padding: 0 44px 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .hero-foot-end {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .hero-count {
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
  }

  .hero-progress {
    position: absolute;
    z-index: 20;
    inset: auto 0 0;
    height: 3px;
    background: rgb(43 33 24 / 0.12);
  }

  .hero-progress div {
    height: 100%;
    background: var(--color-ink);
    transition: width 0.9s cubic-bezier(0.77, 0, 0.18, 1);
  }

  /* ---------- Theme change: replayed each time .is-playing is added back ---------- */
  @keyframes hero-wipe-in {
    from { clip-path: inset(0 0 0 100%); }
    to { clip-path: inset(0); }
  }

  @keyframes hero-wipe-back {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0); }
  }

  @keyframes hero-word-in {
    from { opacity: 0; transform: translateX(calc(var(--dir) * 34vw)); }
    to { opacity: 1; transform: none; }
  }

  @keyframes hero-hang-in {
    0% { opacity: 0; transform: translateX(calc(var(--dir) * 55vw)) rotate(calc(var(--dir) * 14deg)); }
    45% { opacity: 1; transform: translateX(calc(var(--dir) * -2vw)) rotate(calc(var(--dir) * -7deg)); }
    70% { transform: rotate(calc(var(--dir) * 3deg)); }
    88% { transform: rotate(calc(var(--dir) * -1deg)); }
    100% { transform: none; }
  }

  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes hero-shadow {
    0%, 100% { transform: scaleX(1); opacity: 0.32; }
    50% { transform: scaleX(0.92); opacity: 0.26; }
  }

  .is-playing .hero-wipe { animation: hero-wipe-in 0.9s cubic-bezier(0.77, 0, 0.18, 1) both; }
  .is-playing[data-dir='-1'] .hero-wipe { animation-name: hero-wipe-back; }
  .is-playing .hero-word { animation: hero-word-in 1s 0.12s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .is-playing .hero-hang { animation: hero-hang-in 1.5s 0.1s cubic-bezier(0.3, 0.7, 0.3, 1) both; }
  .is-playing .hero-fade { animation: hero-fade-up 0.6s 0.15s ease both; }
  .is-playing :global([data-tag-label]) { display: inline-block; animation: hero-fade-up 0.45s ease both; }
  @keyframes hero-tassel-swing {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(16deg); }
    55% { transform: rotate(-10deg); }
    80% { transform: rotate(4deg); }
  }

