---
import GalleryGrid from '../ui/GalleryGrid.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  images: { src: string; alt: string; title: string }[];
}

const { images } = Astro.props;
---

<section id="gallery" class="surface-section">
  <div class="mx-auto max-w-6xl">
    <SectionHeader title="Our Gallery" subtitle="A glimpse into our diverse collection of creations" />
    <GalleryGrid images={images} columns={3} />
  </div>
</section>
