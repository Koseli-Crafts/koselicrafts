---
import GalleryGrid from '../ui/GalleryGrid.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  images: { src: string; alt: string; title: string }[];
}

const { images } = Astro.props;
---

<section id="gallery" class="surface-section" data-aos="fade-up">
  <div class="mx-auto max-w-6xl">
    <SectionHeader title="Our Gallery" subtitle="Featured visuals from our collection" />
    <GalleryGrid images={images} columns={4} />
  </div>
</section>
