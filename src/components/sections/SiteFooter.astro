---
import TagButton from '../ui/TagButton.astro';
import { CORDS, type CordId } from '../../data/decor';
import { EMAIL, ORDER_LINK, PHONE } from '../../lib/contact';

// A fringe of tassels hanging from the top edge, each on its own length of cord.
const FRINGE: CordId[] = ['pink', 'gold', 'teal', 'cream', 'lavender', 'sage', 'pink', 'gold', 'teal'];
const tassels = FRINGE.map((cord, index) => ({
  src: CORDS[cord].tassel,
  cordLength: 30 + ((index * 47) % 70),
  width: 64 + ((index * 29) % 40),
  delay: index * 0.7,
  duration: 4 + (index % 3)
}));
---

<footer class="site-footer">
  <div class="fringe" aria-hidden="true">
    {tassels.map((tassel) => (
      <div class="sway fringe-tassel" style={{ width: `${tassel.width}px`, animationDelay: `-${tassel.delay.toFixed(1)}s`, animationDuration: `${tassel.duration}s` }}>
        <span style={{ height: `${tassel.cordLength}px` }}></span>
        <img src={tassel.src} alt="" loading="lazy" />
      </div>
    ))}
  </div>

  <div class="footer-main">
    <div class="footer-hello">
      <span class="eyebrow">Say hello</span>
      <p class="footer-order">Order on<br />WhatsApp</p>
      <TagButton href={ORDER_LINK} label="Message us on WhatsApp" size="large" class="footer-button" />
    </div>
    <address class="footer-contact">
      <a href={PHONE.href}>{PHONE.display}</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <span>Kathmandu, Nepal</span>
    </address>
  </div>

  <p class="footer-name" aria-hidden="true" lang="ne">कोसेली</p>

  <div class="footer-bar">
    <span>&copy; 2026 Koseli Crafts. Designed and handcrafted in Nepal.</span>
    <span>Koseli · <span lang="ne">कोसेली</span> · a gift</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--theme-bg);
    color: var(--color-ink);
    transition: background 1s;
  }

  .fringe {
    height: 320px;
    padding: 0 4%;
    display: flex;
    justify-content: space-around;
    border-top: 3px solid var(--color-ink);
  }

  .fringe-tassel span {
    display: block;
    width: 2px;
    margin: 0 auto;
    background: var(--color-ink);
  }

  .fringe-tassel img {
    display: block;
    width: 100%;
    filter: drop-shadow(0 18px 14px rgb(43 33 24 / 0.25));
  }

  .footer-main {
    max-width: 1320px;
    margin: 0 auto;
    padding: 20px 44px 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    flex-wrap: wrap;
  }

  .footer-hello {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .footer-order {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 5vw, 76px);
    line-height: 0.95;
  }

  .footer-hello :global(.footer-button) {
    margin-top: 10px;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: right;
    font-style: normal;
    font-size: 19px;
    font-weight: 500;
  }

  .footer-contact a {
    text-decoration: none;
  }

  .footer-contact a:hover {
    text-decoration: underline;
  }

  .footer-name {
    margin: 30px 0 -0.22em;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 25vw;
    line-height: 1;
    white-space: nowrap;
  }

  .footer-bar {
    position: relative;
    padding: 18px 44px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    background: var(--color-ink);
    color: #e9ddcb;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .fringe {
      height: 220px;
    }

    .fringe > * {
      zoom: 0.6;
    }

    .fringe > :nth-child(n + 7) {
      display: none;
    }

    .footer-main {
      padding: 20px 20px 0;
    }

    .footer-main {
      gap: 44px;
    }

    .footer-hello {
      width: 100%;
      align-items: stretch;
    }

    .footer-hello :global(.footer-button) {
      justify-content: center;
    }

    .footer-contact {
      text-align: left;
    }

    .footer-bar {
      padding: 16px 20px;
    }
  }
</style>
