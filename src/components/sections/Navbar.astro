---
import logo from "../../assets/KoseliCrafts_logo.png";
---

<nav class="fixed top-0 inset-x-0 bg-snow z-50 px-4 md:px-6 backdrop-blur border-b border-spruce/30">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between">
    <div class="logo">
      <img src={logo.src} alt="Koseli Crafts" class="h-9 w-auto md:h-10" />
    </div>
    <p class="text-spruce text-sm">Made in Nepal with ❤️</p>
  </div>
</nav>