---
import TagButton from '../ui/TagButton.astro';
import { THEMES } from '../../lib/themes';
import { displayHeight, loadCatalog } from '../../lib/catalog';
import { piecesLabel } from '../../lib/format';

const products = await loadCatalog();
const capitalize = (text: string) => text[0].toUpperCase() + text.slice(1);
---

<section id="collection" class="collection" data-collection>
  <div class="ghost" data-ghost aria-hidden="true">KOSELI</div>

  <div class="collection-head">
    <div class="collection-labels">
      <span class="eyebrow">Shop the collection</span>
      <span class="eyebrow muted" data-count-label>{piecesLabel(products.length)}</span>
    </div>
    <div role="group" aria-label="Filter by theme" class="tabs">
      <button type="button" class="tab" data-filter="all" data-ghost-word="KOSELI" aria-pressed="true">All</button>
      {THEMES.map((theme) => (
        <button type="button" class="tab" data-filter={theme.id} data-ghost-word={theme.word.toUpperCase()} aria-pressed="false">{theme.nav}</button>
      ))}
    </div>
  </div>

  <p class="side-note hide-below-900">Made in Kathmandu, Nepal</p>

  <div class="cluster" data-cluster>
    {products.map((product, index) => (
      <button
        type="button"
        class="item"
        data-item={index}
        data-piece={product.id}
        data-themes={product.themes.join(' ')}
        aria-label={`See ${product.title}, ${product.priceLabel}`}
      >
        <img
          src={product.image.src}
          data-original-src={product.image.src}
          draggable="false"
          width={product.image.width}
          height={product.image.height}
          alt=""
          loading={index < 5 ? 'eager' : 'lazy'}
          style={{ '--display-height': displayHeight(product.image) }}
        />
        <span class="item-shadow" aria-hidden="true"></span>
      </button>
    ))}

    <div class="panel" data-panel aria-live="polite">
      {products.map((product, index) => (
        <div class="panel-body" data-panel-for={index} hidden>
          <span class="eyebrow muted">{product.kind} · {product.cordLabel}</span>
          <h3>{product.title}</h3>
          <p class="panel-text">{product.description}</p>
          {product.swatches.length > 1 && (
            <div class="swatches">
              <span class="eyebrow muted">Macramé colour · <span data-swatch-state>original</span></span>
              <div role="radiogroup" aria-label="Macramé colour" class="swatch-row" data-swatch-group={index} data-source-color={product.swatches[0].hex}>
                {product.swatches.map((swatch, k) => {
                  const label = k === 0 ? `Original colour, ${swatch.name}` : capitalize(swatch.name);
                  return (
                    <button
                      type="button"
                      role="radio"
                      class="swatch"
                      aria-checked={k === 0 ? 'true' : 'false'}
                      tabindex={k === 0 ? 0 : -1}
                      aria-label={label}
                      title={label}
                      data-swatch-color={swatch.hex}
                      data-swatch-name={swatch.name}
                    >
                      <span style={{ background: swatch.hex }}></span>
                    </button>
                  );
                })}
              </div>
            </div>
          )}
          <div class="panel-order">
            <span class="price">{product.priceLabel}</span>
            <TagButton href={product.orderLink} label="Order on WhatsApp" data-order-title={product.title} data-order-url={product.shareUrl} />
          </div>
          <button type="button" class="wavy-link share" data-share={product.title} data-share-url={product.shareUrl}>Share this piece</button>
        </div>
      ))}
    </div>

    <div class="close-wrap" data-close-wrap hidden>
      <button type="button" class="bead bead--small" data-unselect aria-label="Back to the collection">✕</button>
    </div>
  </div>

  <p class="caption eyebrow muted" data-caption>Tap a piece to look closer</p>

  <button type="button" class="bead side-step side-step--prev" data-cluster-step="-1" aria-label="Previous pieces">←</button>
  <button type="button" class="bead side-step side-step--next" data-cluster-step="1" aria-label="Next pieces">→</button>

  <div class="collection-foot">
    <div class="step hide-below-760">
      <span class="step-no" data-step-no>01</span>
      <span class="step-rule"></span>
      <span class="step-label" data-step-label>The<br />collection</span>
    </div>
    <div class="pager" data-pager>
      <button type="button" class="bead bead--small pager-arrow" data-cluster-step="-1" aria-label="Previous pieces">←</button>
      <div class="dots" aria-hidden="true">
        {products.map(() => <span class="dot"></span>)}
      </div>
      <button type="button" class="bead bead--small pager-arrow" data-cluster-step="1" aria-label="Next pieces">→</button>
    </div>
    <span class="eyebrow hide-below-900" data-step-hint>Tap a piece to look closer</span>
  </div>
</section>

<script>
  import { piecesLabel } from '../../lib/format';
  import { recolorImage } from '../../lib/recolor';
  import { productOrderLink } from '../../lib/contact';
  import { SHOW_THEME_EVENT } from '../../scripts/theme';

  const section = document.querySelector<HTMLElement>('[data-collection]')!;
  const cluster = section.querySelector<HTMLElement>('[data-cluster]')!;
  const items = [...section.querySelectorAll<HTMLButtonElement>('[data-item]')];
  const panel = section.querySelector<HTMLElement>('[data-panel]')!;
  const panelBodies = [...section.querySelectorAll<HTMLElement>('[data-panel-for]')];
  const tabs = [...section.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const dots = [...section.querySelectorAll<HTMLElement>('.dot')];
  const ghost = section.querySelector<HTMLElement>('[data-ghost]')!;
  const countLabel = section.querySelector<HTMLElement>('[data-count-label]')!;
  const closeWrap = section.querySelector<HTMLElement>('[data-close-wrap]')!;
  const pager = section.querySelector<HTMLElement>('[data-pager]')!;
  const stepNo = section.querySelector<HTMLElement>('[data-step-no]')!;
  const stepLabel = section.querySelector<HTMLElement>('[data-step-label]')!;
  const stepHint = section.querySelector<HTMLElement>('[data-step-hint]')!;
  const phone = window.matchMedia('(max-width: 760px)');
  const caption = section.querySelector<HTMLElement>('[data-caption]')!;

  /**
   * Each piece and each filter has its own address, e.g. /#rustic-psalm-23-wall-art
   * or /#christmas, so a shared link opens it.
   */
  const addressName = () => decodeURIComponent(location.hash.slice(1));
  const pieceFromAddress = () => items.find((item) => item.dataset.piece === addressName());
  const filterFromAddress = () => tabs.find((tab) => tab.dataset.filter !== 'all' && tab.dataset.filter === addressName());

  function syncAddress() {
    const wanted = selected >= 0 ? items[selected].dataset.piece! : filter === 'all' ? '' : filter;
    if (addressName() === wanted) return;
    // Leave other anchors such as #questions alone; only clear a piece's or filter's own address.
    if (!wanted && !pieceFromAddress() && !filterFromAddress()) return;
    history.replaceState(history.state, '', `${location.pathname}${location.search}${wanted && `#${wanted}`}`);
  }

  let filter = 'all';
  let centered = 2;
  let selected = -1;

  const visibleItems = () =>
    items.filter((item) => filter === 'all' || item.dataset.themes!.split(' ').includes(filter));

  interface Spot { x: number; y: number; scale: number; opacity: number; rotate: number; layer: number; blur: number }

  /**
   * On phones the open piece sits between the filter buttons and the details
   * panel. The section grows to leave the piece PHONE_PIECE_ROOM above the panel,
   * however long the description, and the piece fills that room up to the size
   * wide screens show it at (phones show pieces at half that while browsing).
   */
  const PHONE_PIECE_ROOM = 320;
  const PHONE_OPEN_SCALE = 2;
  const BREATHING_ROOM = 8;
  const filterRow = section.querySelector<HTMLElement>('.tabs')!;

  /** Grows the section on phones so the open piece keeps its room above the panel. */
  function fitPhoneSection(focused: boolean) {
    if (!focused || !phone.matches) {
      section.style.height = '';
      return;
    }
    const roomTop = filterRow.getBoundingClientRect().bottom - section.getBoundingClientRect().top;
    const panelBelowSection = section.offsetHeight - (cluster.offsetTop + panel.offsetTop + panel.offsetHeight);
    section.style.height = `${Math.ceil(roomTop + 2 * BREATHING_ROOM + PHONE_PIECE_ROOM + panel.offsetHeight + panelBelowSection)}px`;
  }

  function phoneOpenSpot(item: HTMLElement): Spot {
    const roomTop = filterRow.getBoundingClientRect().bottom - cluster.getBoundingClientRect().top + BREATHING_ROOM;
    const roomBottom = panel.offsetTop - BREATHING_ROOM;
    const scale = Math.min(PHONE_OPEN_SCALE, (roomBottom - roomTop) / item.offsetHeight);
    const restingBottom = item.offsetTop + item.offsetHeight;
    return { x: 0, y: roomBottom - restingBottom, scale, opacity: 1, rotate: 0, layer: 20, blur: 0 };
  }

  /** The open piece: beside the panel on wide screens, between filters and panel on phones. */
  function openSpot(item: HTMLElement): Spot {
    return phone.matches
      ? phoneOpenSpot(item)
      : { x: -150, y: 0, scale: 1.12, opacity: 1, rotate: 0, layer: 20, blur: 0 };
  }

  /** The other pieces slide away to the sides while one is open. */
  function hiddenSpot(offset: number): Spot {
    return { x: Math.sign(offset) * (700 + Math.abs(offset) * 120), y: 0, scale: 0.7, opacity: 0, rotate: 0, layer: 1, blur: 8 };
  }

  /** Browsing: the centred piece in front, neighbours fanned out behind it. */
  function browsingSpot(offset: number): Spot {
    const distance = Math.abs(offset);
    return phone.matches
      ? { x: offset * 120, y: 0, scale: 1 - distance * 0.14, opacity: distance > 1 ? 0 : 1 - distance * 0.1, rotate: offset * 5, layer: 20 - distance, blur: 0 }
      : { x: offset * 230, y: 0, scale: 1 - distance * 0.1, opacity: distance > 2 ? 0 : 1 - distance * 0.12, rotate: offset * 4, layer: 20 - distance, blur: distance > 1 ? 1 : 0 };
  }

  const transformFor = (spot: Spot, dragX = 0) =>
    `translateX(calc(-50% + ${spot.x + dragX}px)) translateY(${spot.y}px) scale(${spot.scale}) rotate(${spot.rotate}deg)`;

  /** Where each visible piece was last placed, so a drag can move it from there. */
  const spots = new Map<HTMLElement, Spot>();

  const ENTER_EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const ENTER_STAGGER_MS = 40;
  const ENTER_MAX_DELAY_MS = 160;
  let hasRendered = false;

  /** A piece that was hidden by the last filter rises into its new spot. */
  function enter(item: HTMLElement, order: number) {
    const transform = item.style.transform;
    const opacity = Number(item.style.opacity);
    if (reduceMotion.matches) {
      item.animate([{ opacity: 0 }, { opacity }], { duration: 200, easing: ENTER_EASE });
      return;
    }
    item.animate(
      [
        { opacity: 0, transform: `${transform} translateY(16px) scale(0.96)` },
        { opacity, transform }
      ],
      {
        duration: 300,
        easing: ENTER_EASE,
        delay: Math.min(order * ENTER_STAGGER_MS, ENTER_MAX_DELAY_MS),
        fill: 'backwards'
      }
    );
  }

  /**
   * The pieces form a ring: a piece's place counts from the centred one the
   * shorter way round, so the last piece waits just left of the first.
   */
  function ringOffset(position: number, center: number, count: number) {
    const half = Math.floor(count / 2);
    return ((position - center + half) % count + count) % count - half;
  }

  /** Each piece's place at the last render, to spot one that wraps round the ring. */
  const lastOffsets = new Map<HTMLElement, number>();

  /** A piece wrapping from one end of the ring to the other fades in at its new place instead of sliding across. */
  function jump(item: HTMLElement, order: number) {
    item.style.transition = 'none';
    void item.offsetWidth;
    item.style.transition = '';
    enter(item, order);
  }

  function render() {
    const list = visibleItems();
    const selectedPosition = list.findIndex((item) => Number(item.dataset.item) === selected);
    const focused = selectedPosition >= 0;
    const center = focused ? selectedPosition : Math.min(centered, list.length - 1);

    // Show the panel text and close button first, so their sizes are known before placing the piece.
    section.classList.toggle('is-open', focused);
    panel.classList.toggle('is-open', focused);
    panelBodies.forEach((body, index) => { body.hidden = index !== selected; });
    closeWrap.hidden = !focused;
    fitPhoneSection(focused);

    const wasHidden = new Set(items.filter((item) => item.hidden));
    items.forEach((item) => { item.hidden = !list.includes(item); });
    let entering = 0;
    list.forEach((item, k) => {
      const offset = ringOffset(k, center, list.length);
      const lastOffset = lastOffsets.get(item);
      const wrapped = lastOffset !== undefined && list.length > 2 && Math.abs(offset - lastOffset) >= list.length - 1;
      lastOffsets.set(item, offset);
      const spot = !focused ? browsingSpot(offset) : offset === 0 ? openSpot(item) : hiddenSpot(offset);
      item.style.zIndex = String(spot.layer);
      item.style.opacity = String(spot.opacity);
      item.style.filter = `blur(${spot.blur}px)`;
      item.style.pointerEvents = spot.opacity > 0 ? 'auto' : 'none';
      item.style.transform = transformFor(spot);
      spots.set(item, spot);
      item.tabIndex = spot.opacity > 0 ? 0 : -1;
      if (hasRendered && wasHidden.has(item) && spot.opacity > 0) enter(item, entering++);
      else if (hasRendered && wrapped && spot.opacity > 0) jump(item, 0);
    });

    pager.hidden = focused;
    caption.hidden = focused;
    dots.forEach((dot, k) => {
      dot.hidden = k >= list.length;
      dot.classList.toggle('is-current', k === center);
    });

    stepNo.textContent = focused ? '02' : '01';
    stepLabel.innerHTML = focused ? 'Your<br>piece' : 'The<br>collection';
    stepHint.textContent = focused ? 'Tap ✕ to see them all' : 'Tap a piece to look closer';

    const tab = tabs.find((t) => t.dataset.filter === filter)!;
    tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
    ghost.textContent = tab.dataset.ghostWord!;
    countLabel.textContent = piecesLabel(list.length) + (filter === 'all' ? '' : ` · ${tab.textContent}`);
    syncAddress();
    hasRendered = true;
  }

  function setFilter(id: string) {
    filter = id;
    selected = -1;
    centered = Math.floor((visibleItems().length - 1) / 2);
    render();
  }

  function replayPanelSwap() {
    panel.classList.remove('is-swapping');
    void panel.offsetWidth;
    panel.classList.add('is-swapping');
  }

  /** Past the last piece comes the first again, and before the first, the last. */
  function step(direction: number) {
    const count = visibleItems().length;
    centered = (Math.min(centered, count - 1) + direction + count) % count;
    render();
  }

  // Swipe the pieces left and right. While the finger is down the pieces follow it;
  // on release they settle on the next piece or spring back.
  const FOLLOW = 0.6;
  const COMMIT_DISTANCE = 40;
  const COMMIT_SPEED = 0.11; // px per ms
  const TAP_TOLERANCE = 10;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let swipeStartX: number | null = null;
  let swipePointer: number | null = null;
  let swipeStartTime = 0;
  let justSwiped = false;


  // Letting go hands the pieces back to their normal transition, which settles them.
  function settle() {
    cluster.classList.remove('is-dragging');
  }

  cluster.addEventListener('pointerdown', (event) => {
    if (selected >= 0 || swipeStartX !== null) return;
    swipePointer = event.pointerId;
    swipeStartX = event.clientX;
    swipeStartTime = event.timeStamp;
    justSwiped = false;
  });

  cluster.addEventListener('pointermove', (event) => {
    if (event.pointerId !== swipePointer) return;
    if (swipeStartX === null || reduceMotion.matches) return;
    const dx = event.clientX - swipeStartX;
    if (Math.abs(dx) < TAP_TOLERANCE) return;
    if (!cluster.hasPointerCapture(event.pointerId)) cluster.setPointerCapture(event.pointerId);
    cluster.classList.add('is-dragging');
    const dragX = dx * FOLLOW;
    spots.forEach((spot, item) => {
      if (!item.hidden) item.style.transform = transformFor(spot, dragX);
    });
  });

  cluster.addEventListener('pointerup', (event) => {
    if (event.pointerId !== swipePointer) return;
    if (swipeStartX === null) return;
    const dx = event.clientX - swipeStartX;
    const speed = Math.abs(dx) / Math.max(1, event.timeStamp - swipeStartTime);
    swipeStartX = null;
    swipePointer = null;
    if (Math.abs(dx) < TAP_TOLERANCE) {
      cluster.classList.remove('is-dragging');
      return;
    }
    justSwiped = true;
    settle();
    if (Math.abs(dx) > COMMIT_DISTANCE || speed > COMMIT_SPEED) step(dx < 0 ? 1 : -1);
    else render();
  });

  cluster.addEventListener('pointercancel', (event) => {
    if (event.pointerId !== swipePointer) return;
    if (swipeStartX === null) return;
    swipeStartX = null;
    swipePointer = null;
    settle();
    render();
  });

  // A press that leaves the pieces before becoming a drag (so no capture was
  // taken) would never see its release; forget it so the next press works.
  cluster.addEventListener('pointerleave', (event) => {
    if (event.pointerId !== swipePointer || cluster.hasPointerCapture(event.pointerId)) return;
    swipeStartX = null;
    swipePointer = null;
    cluster.classList.remove('is-dragging');
  });

  function openPiece(item: HTMLElement) {
    selected = Number(item.dataset.item);
    centered = visibleItems().indexOf(item);
    replayPanelSwap();
    render();
  }

  items.forEach((item) => {
    item.addEventListener('click', () => {
      if (justSwiped) { justSwiped = false; return; }
      openPiece(item);
    });
  });

  /** Opens the piece or filter named in the address. Returns false when it names neither. */
  function showAddress() {
    const item = pieceFromAddress();
    const tab = filterFromAddress();
    if (item) {
      if (!visibleItems().includes(item)) filter = 'all';
      openPiece(item);
    } else if (tab) {
      setFilter(tab.dataset.filter!);
    } else {
      return false;
    }
    section.scrollIntoView({ block: 'start' });
    return true;
  }
  window.addEventListener('hashchange', () => showAddress());

  section.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
    const label = button.textContent!;
    button.addEventListener('click', async () => {
      const url = button.dataset.shareUrl!;
      if (navigator.share) {
        await navigator.share({ title: button.dataset.share, url }).catch(() => {});
        return;
      }
      await navigator.clipboard.writeText(url);
      button.textContent = 'Link copied';
      window.setTimeout(() => { button.textContent = label; }, 2000);
    });
  });

  section.querySelector('[data-unselect]')!.addEventListener('click', () => {
    selected = -1;
    render();
  });
  section.querySelectorAll<HTMLButtonElement>('[data-cluster-step]').forEach((button) => {
    button.addEventListener('click', () => step(Number(button.dataset.clusterStep)));
  });
  tabs.forEach((tab) => tab.addEventListener('click', () => setFilter(tab.dataset.filter!)));
  document.addEventListener(SHOW_THEME_EVENT, (event) => setFilter((event as CustomEvent<string>).detail));
  phone.addEventListener('change', render);

  // Macramé colours: exactly one swatch is chosen; the first is the piece's own.
  // Works like a set of radio buttons: Tab reaches the chosen one, arrow keys move.
  const NEXT_KEYS = ['ArrowRight', 'ArrowDown'];
  const PREVIOUS_KEYS = ['ArrowLeft', 'ArrowUp'];

  const RECOLOUR_DIM_AFTER_MS = 120;
  const RECOLOUR_FADE_MS = 200;

  section.querySelectorAll<HTMLElement>('[data-swatch-group]').forEach((group) => {
    const image = items[Number(group.dataset.swatchGroup)].querySelector('img')!;
    const original = image.dataset.originalSrc!;
    const sourceColor = group.dataset.sourceColor!;
    const state = group.parentElement!.querySelector('[data-swatch-state]')!;
    const swatches = [...group.querySelectorAll<HTMLButtonElement>('[data-swatch-color]')];
    const orderLink = group.closest('[data-panel-for]')!.querySelector<HTMLAnchorElement>('[data-order-title]')!;
    let wanted = sourceColor;

    async function choose(swatch: HTMLButtonElement) {
      swatches.forEach((other) => {
        other.setAttribute('aria-checked', String(other === swatch));
        other.tabIndex = other === swatch ? 0 : -1;
      });
      wanted = swatch.dataset.swatchColor!;
      state.textContent = wanted === sourceColor ? 'original' : 'recoloured';
      orderLink.href = productOrderLink(
        orderLink.dataset.orderTitle!,
        orderLink.dataset.orderUrl!,
        wanted === sourceColor ? undefined : swatch.dataset.swatchName
      );
      const target = wanted;

      // Show the tap registered if the recolouring takes a moment. Only the
      // latest choice may dim, so an older, slower one can't leave it dimmed.
      const dim = window.setTimeout(() => {
        if (wanted === target) image.style.opacity = '0.85';
      }, RECOLOUR_DIM_AFTER_MS);
      const url = await recolorImage(original, sourceColor, target);
      window.clearTimeout(dim);
      if (wanted !== target) return;

      image.src = url;
      await image.decode().catch(() => {});
      image.style.opacity = '';
      image.animate([{ opacity: 0.6 }, { opacity: 1 }], {
        duration: RECOLOUR_FADE_MS,
        easing: 'cubic-bezier(0.23, 1, 0.32, 1)'
      });
    }

    swatches.forEach((swatch, index) => {
      swatch.addEventListener('click', () => choose(swatch));
      swatch.addEventListener('keydown', (event) => {
        const move =
          NEXT_KEYS.includes(event.key) ? 1 :
          PREVIOUS_KEYS.includes(event.key) ? -1 :
          event.key === 'Home' ? -index :
          event.key === 'End' ? swatches.length - 1 - index : 0;
        if (!move) return;
        event.preventDefault();
        const target = swatches[(index + move + swatches.length) % swatches.length];
        target.focus();
        choose(target);
      });
    });
  });

  if (!showAddress()) render();
</script>

<style>
  .collection {
    position: relative;
    height: 960px;
    overflow: hidden;
    background: var(--color-paper);
  }

  .muted {
    color: var(--color-muted);
  }

  .ghost {
    position: absolute;
    inset: 150px 0 auto;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 300px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ghost);
    pointer-events: none;
  }

  /* Labels on the left, the filter tags centred on the page. */
  .collection-head {
    position: absolute;
    top: 40px;
    left: 48px;
    right: 48px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 20px;
  }

  .collection-labels {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* The filters hang like gift tags from one string. The string is the row's
     background, so on phones it scrolls along with the tags. */
  /* Too narrow for labels and tags side by side: the tags go under the labels. */
  @media (max-width: 1100px) {
    .collection-head {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .tabs {
    --string-y: 20px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0 24px;
    background: linear-gradient(var(--color-ink), var(--color-ink)) no-repeat 0 var(--string-y) / 100% 2px;
    background-attachment: local;
  }

  .tab {
    position: relative;
    margin-top: 36px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 16px 15px 9px;
    border: 0;
    border-radius: 5px 5px 14px 14px;
    background: #fff;
    color: var(--color-ink);
    font: 600 14px var(--font-body);
    cursor: pointer;
    transform-origin: 50% -16px;
    box-shadow: 0 8px 16px rgb(43 33 24 / 0.14);
    transition: transform 0.55s cubic-bezier(0.3, 1.6, 0.5, 1), background 0.3s, color 0.3s;
  }

