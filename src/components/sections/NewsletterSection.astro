---
import EmailForm from '../ui/EmailForm.astro';
---

<section id="newsletter" class="content-section">
  <div class="mx-auto max-w-3xl rounded-2xl border border-spruce/20 bg-surface p-8 text-center shadow-[0_14px_34px_rgba(17,33,19,0.09)] md:p-12">
    <h2 class="mb-3 text-4xl font-semibold tracking-tight text-pine md:text-5xl">Join Our Community</h2>
    <p class="mb-8 text-base leading-8 text-spruce md:text-lg">Subscribe for exclusive updates, new collection announcements, and special offers. We'll send you inspiration and beauty straight to your inbox.</p>
    <EmailForm />
  </div>
</section>
