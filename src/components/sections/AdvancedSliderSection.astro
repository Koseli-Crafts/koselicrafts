---
import artisanCraftingMacrame from '../../assets/artisan-crafting-macrame.png';
import livingRoom from '../../assets/minimalist-scandinavian-living-room-decor.png';

const slides = [
  {
    title: 'Handcrafted with Heart and Detail',
    caption:
      'Every piece is made by hand — from macramé knots to laser-engraved wood.',
    image: artisanCraftingMacrame.src,
    imageAlt: 'Artisan woman hand-knotting a blue macramé piece on a wooden dowel.'
  },
  {
    title: 'Made for Personal Style',
    caption:
      'Custom touches that make displays feel warm and memorable.',
    image: livingRoom.src,
    imageAlt: 'Personalized decorative design with handcrafted details.'
  }
];
---

<section id="featured" class="mt-16 px-4 pt-4 md:px-6 md:pt-5" data-advanced-slider-section>
  <div class="mx-auto max-w-7xl">
    <div class="relative isolate overflow-hidden rounded-lg bg-pine shadow-[0_28px_80px_rgba(30,28,24,0.22)] min-h-[clamp(24rem,62vw,34rem)] max-md:min-h-112">
      {slides.map((slide, index) => (
        <article
          class:list={[
            'absolute inset-0 transition-opacity duration-700 ease-out',
            index === 0 ? 'pointer-events-auto opacity-100' : 'pointer-events-none opacity-0'
          ]}
          data-slide
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <img class="h-full w-full object-cover" src={slide.image} alt={slide.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(90deg, rgba(30, 28, 24, 0.78) 0%, rgba(30, 28, 24, 0.3) 44%, rgba(30, 28, 24, 0.08) 100%), linear-gradient(180deg, rgba(30, 28, 24, 0.12) 0%, rgba(30, 28, 24, 0.4) 100%);"
          ></div>
          <div class="absolute inset-x-0 bottom-0 z-10 flex max-w-lg flex-col gap-3.5 px-5 pb-6 pt-16 text-white sm:left-0 sm:top-1/2 sm:bottom-auto sm:-translate-y-1/2 sm:px-8 md:px-10">
            <span class="w-fit rounded-md border border-white/30 bg-white/8 px-2.5 py-1 text-[0.76rem] font-semibold uppercase tracking-[0.18em] text-white/84 backdrop-blur-sm animate-fadeup" style="animation-delay: 0ms;">Koseli Crafts</span>
            <h2 class="m-0 max-w-md text-[clamp(1.8rem,8vw,2.55rem)] leading-tight font-semibold text-white md:text-[3.3rem] animate-fadeup" style="animation-delay: 100ms;">{slide.title}</h2>
            <p class="m-0 max-w-md text-[1rem] leading-6.5 text-white/82 md:text-[1.02rem] animate-fadeup" style="animation-delay: 200ms;">{slide.caption}</p>
          </div>
        </article>
      ))}

    </div>

    <div class="mt-3.5 flex flex-col gap-2 px-1 sm:flex-row sm:items-center sm:justify-between sm:gap-2.5">
      <div class="h-0.75 flex-1 overflow-hidden rounded-full bg-pine/12" aria-hidden="true">
        <span class="block h-full w-0 rounded-full bg-patrol" data-slider-progress></span>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:justify-end" role="tablist" aria-label="Slider pagination">
        {slides.map((slide, index) => (
          <button
            type="button"
            class:list={[
              'min-w-10 rounded-sm border border-pine/15 px-2.5 py-1 text-[0.8rem] font-semibold tracking-[0.12em] text-spruce transition duration-300 hover:border-patrol/40 hover:text-patrol hover:bg-transparent',
              index === 0 ? 'border-patrol bg-patrol text-white' : 'bg-surface'
            ]}
            data-slider-dot
            data-index={index}
            aria-label={`Show slide ${index + 1}: ${slide.title}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            role="tab"
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ autoPlayDelay: 5000 }}>
  const sliderSections = document.querySelectorAll('[data-advanced-slider-section]');

  sliderSections.forEach((section) => {
    const slides = Array.from(section.querySelectorAll('[data-slide]'));
    const dots = Array.from(section.querySelectorAll('[data-slider-dot]'));
    const progressFill = section.querySelector('[data-slider-progress]');

    if (!slides.length || !dots.length) {
      return;
    }

    let activeIndex = 0;
    let intervalId;

    const syncUi = (index) => {
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle('pointer-events-auto', isActive);
        slide.classList.toggle('opacity-100', isActive);
        slide.classList.toggle('pointer-events-none', !isActive);
        slide.classList.toggle('opacity-0', !isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === index;
        dot.classList.toggle('border-patrol', isActive);
        dot.classList.toggle('bg-patrol', isActive);
        dot.classList.toggle('text-white', isActive);
        dot.classList.toggle('bg-surface', !isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });

      runProgressAnimation();
    };

    const runProgressAnimation = () => {
      if (!(progressFill instanceof HTMLElement)) {
        return;
      }

      progressFill.style.transition = 'none';
      progressFill.style.width = '0%';
      // Force reflow so the animation cleanly restarts every slide.
      void progressFill.offsetWidth;
      progressFill.style.transition = `width ${autoPlayDelay}ms linear`;
      progressFill.style.width = '100%';
    };

    const goToSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      syncUi(activeIndex);
      restartAutoPlay();
    };

    const restartAutoPlay = () => {
      window.clearInterval(intervalId);
      intervalId = window.setInterval(() => {
        activeIndex = (activeIndex + 1) % slides.length;
        syncUi(activeIndex);
      }, autoPlayDelay);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    section.addEventListener('mouseenter', () => window.clearInterval(intervalId));
    section.addEventListener('mouseleave', () => {
      runProgressAnimation();
      restartAutoPlay();
    });

    syncUi(activeIndex);
    restartAutoPlay();
  });
</script>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.animate-fadeup) {
    animation: fadeUp 0.6s ease-out forwards;
  }
</style>