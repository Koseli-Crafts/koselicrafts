---
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="contact" class="content-section">
  <SectionHeader title="Order or Inquire" subtitle="Get in touch with us to place an order or customize your perfect piece" />
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
    <form class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm font-semibold text-pine">Full Name *</label>
        <input type="text" id="name" name="name" required placeholder="Your name" class="input-field">
      </div>
      <div class="flex flex-col gap-2">
        <label for="email" class="text-sm font-semibold text-pine">Email Address *</label>
        <input type="email" id="email" name="email" required placeholder="your@email.com" class="input-field">
      </div>
      <div class="flex flex-col gap-2">
        <label for="phone" class="text-sm font-semibold text-pine">Phone Number</label>
        <input type="tel" id="phone" name="phone" placeholder="+1 (555) 123-4567" class="input-field">
      </div>
      <div class="flex flex-col gap-2">
        <label for="product" class="text-sm font-semibold text-pine">Product Interest *</label>
        <select id="product" name="product" required class="input-field">
          <option value="">Select a product</option>
          <option value="bible-verse">Bible Verse Wall Art</option>
          <option value="inspirational">Inspirational Scripture Plaque</option>
          <option value="custom">Custom Personalized Piece</option>
          <option value="premium">Premium Display Masterpiece</option>
          <option value="other">Other / Multiple Items</option>
        </select>
      </div>
      <div class="flex flex-col gap-2">
        <label for="message" class="text-sm font-semibold text-pine">Message or Special Requests</label>
        <textarea id="message" name="message" placeholder="Tell us about your custom design or special requirements..." rows="5" class="input-field"></textarea>
      </div>
      <div class="flex items-center gap-3">
        <input type="checkbox" id="terms" name="terms" class="h-4.5 w-4.5 cursor-pointer rounded border-spruce/30 text-patrol">
        <label for="terms" class="cursor-pointer text-sm text-spruce">I'd like to receive updates about new collections and offers</label>
      </div>
      <button type="submit" class="btn btn-primary mt-2 w-full sm:w-auto">Send Inquiry</button>
    </form>
    <div class="grid grid-cols-1 gap-6">
      <div class="info-card"><h4>📧 Email</h4><p class="text-spruce"><a href="mailto:info@koselicraft.com" class="font-semibold text-patrol transition-colors duration-300 hover:text-pine">info@koselicraft.com</a></p></div>
      <div class="info-card"><h4>📱 Phone</h4><p class="text-spruce"><a href="tel:+15551234567" class="font-semibold text-patrol transition-colors duration-300 hover:text-pine">+1 (555) 123-4567</a></p></div>
      <div class="info-card"><h4>🕐 Hours</h4><p class="leading-8 text-spruce">Mon-Fri: 9AM-5PM<br>Sat: 10AM-4PM<br>Sun: Closed</p></div>
    </div>
  </div>
</section>
