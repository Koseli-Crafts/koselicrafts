---
import SectionHeader from '../ui/SectionHeader.astro';
---

<section id="contact" class="content-section" data-aos="fade-up">
  <SectionHeader title="Let's Connect" subtitle="Tell us your idea in a few lines" />
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
    <form class="flex flex-col gap-4.5">
      <div class="flex flex-col gap-2">
        <label for="name" class="text-[0.92rem] font-semibold text-pine">Full Name *</label>
        <input type="text" id="name" name="name" required placeholder="Your name" class="input-field">
      </div>
      <div class="flex flex-col gap-2">
        <label for="email" class="text-[0.92rem] font-semibold text-pine">Email Address *</label>
        <input type="email" id="email" name="email" required placeholder="your@email.com" class="input-field">
      </div>
      <div class="flex flex-col gap-2">
        <label for="phone" class="text-[0.92rem] font-semibold text-pine">Phone Number</label>
        <input type="tel" id="phone" name="phone" placeholder="+977 9812345678" class="input-field">
      </div>
      <div class="flex flex-col gap-2">
        <label for="product" class="text-[0.92rem] font-semibold text-pine">Product Interest *</label>
        <select id="product" name="product" required class="input-field">
          <option value="">Select a product</option>
          <option value="wall-display">Wall Display Piece</option>
          <option value="counter-accent">Counter or Shelf Accent</option>
          <option value="custom">Custom Personalized Piece</option>
          <option value="premium">Premium Statement Piece</option>
          <option value="other">Other / Multiple Items</option>
        </select>
      </div>
      <div class="flex flex-col gap-2">
        <label for="message" class="text-[0.92rem] font-semibold text-pine">Message or Special Requests</label>
        <textarea id="message" name="message" placeholder="Tell us about your custom design or special requirements..." rows="5" class="input-field"></textarea>
      </div>
      <div class="flex items-center gap-3">
        <input type="checkbox" id="terms" name="terms" class="h-4.5 w-4.5 cursor-pointer rounded border-spruce/30 text-patrol">
        <label for="terms" class="cursor-pointer text-[0.94rem] text-spruce">I'd like to receive updates about new collections and offers</label>
      </div>
      <button type="submit" class="btn btn-primary mt-2 w-full sm:w-auto">Send Inquiry</button>
    </form>
    <div class="grid grid-cols-1 gap-4.5">
      <div class="info-card"><h4>📧 Email</h4><p class="text-[1rem] text-spruce"><a href="mailto:info@koselicraft.com" class="font-semibold text-patrol transition-colors duration-300 hover:text-pine">info@koselicraft.com</a></p></div>
      <div class="info-card"><h4>📱 Phone</h4><p class="text-[1rem] text-spruce"><a href="tel:+9779812345678" class="font-semibold text-patrol transition-colors duration-300 hover:text-pine">+977 9812345678</a></p></div>
      <div class="info-card"><h4>📍 Studio</h4><p class="leading-7 text-[1rem] text-spruce">Kathmandu, Nepal<br>Lalitpur appointments available</p></div>
    </div>
  </div>
</section>
