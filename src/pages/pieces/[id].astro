---
// A piece's own address, for sharing. Link previews read its tags; people are sent
// straight on to the piece in the shop.
import ShareTags from '../../components/ShareTags.astro';
import { loadCatalog } from '../../lib/catalog';
import { SITE_ROOT, absoluteUrl, piecePage, shareImagePath } from '../../lib/site';

export async function getStaticPaths() {
  const products = await loadCatalog();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const shopLink = `${SITE_ROOT}/#${product.id}`;
const title = `${product.title} · Koseli Crafts`;
const description = `${product.priceLabel}. ${product.description}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(piecePage(product.id))} />
    <ShareTags title={title} description={description} url={absoluteUrl(piecePage(product.id))} image={absoluteUrl(shareImagePath(product.id))} />
    <!-- A choice rides along after a #: /pieces/x/#red-satin-ribbon opens /#x/red-satin-ribbon.
         It runs before the refresh below, which only serves browsers without JavaScript. -->
    <script is:inline define:vars={{ shopLink }}>location.replace(shopLink + (location.hash ? `/${location.hash.slice(1)}` : ''));</script>
    <noscript><meta http-equiv="refresh" content={`0; url=${shopLink}`} /></noscript>
  </head>
  <body>
    <p><a href={shopLink}>See {product.title} at Koseli Crafts</a></p>
  </body>
</html>
