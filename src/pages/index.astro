---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import AdvancedSliderSection from '../components/sections/AdvancedSliderSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import CTASection from '../components/sections/CTASection.astro';

const faqs = [
{
question: "What materials do you use?",
answer: "We use responsibly sourced hardwood selected for grain quality and durability. Engravings are done with precision laser technology and finished by hand with eco-conscious sealants."
},
{
question: "Are your pieces suitable for gifts?",
answer: "Yes, our handcrafted decor items make thoughtful and unique gifts for any occasion."
},
{
question: "How can I place an order?",
answer: "You can place an order by contacting us in WhatsApp. We will guide you through the process and help you select the perfect piece for your space or as a gift."
},
{
question: "Do you offer custom designs?",
answer: "Yes, we offer custom design services. Please contact us to discuss your ideas and we will work with you to create a unique piece that fits your vision."
}
];
---

<Layout>
<div class="site-shell">
	<Navbar />
	<AdvancedSliderSection />
	<ProductsSection />
	<FaqSection faqs={faqs} />
	<CTASection />
	<SiteFooter />
</div>
</Layout>
