---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import AdvancedSliderSection from '../components/sections/AdvancedSliderSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import CTASection from '../components/sections/CTASection.astro';

const faqs = [
{
question: "How do I order?",
answer: "Tap a piece and press “Order on WhatsApp”. Your message will name the piece, and we’ll confirm the details with you in the chat. You can also call or email us."
},
{
question: "How do payment and delivery work?",
answer: "It depends on the piece and where it’s going. Message us and we’ll explain the options for your order."
},
{
question: "Can you engrave my own words?",
answer: "Yes. Send us a verse, a name or a message, in Nepali or English, and we’ll talk through the design with you."
},
{
question: "Do you make pieces for churches and groups?",
answer: "Yes. Tell us how many pieces you need and what they should say, and we’ll plan the order with you."
},
{
question: "What are the pieces made of?",
answer: "We engrave wood or MDF on our own laser in Kathmandu. Macramé pieces are knotted by hand from cotton cord. Ask us if you’d like to know what a particular piece is made of."
}
];
---

<Layout>
<div class="site-shell">
	<Navbar />
	<AdvancedSliderSection />
	<ProductsSection />
	<FaqSection faqs={faqs} />
	<CTASection />
	<SiteFooter />
</div>
</Layout>
