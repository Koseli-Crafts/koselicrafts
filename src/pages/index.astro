---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import FeaturedSection from '../components/sections/FeaturedSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import WhyChooseSection from '../components/sections/WhyChooseSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import productFaithInspiration from '../assets/product-faith-inspiration.jpg';
import productDivineLove from '../assets/product-divine-love.jpg';
import productGracePlaque from '../assets/product-grace-plaque.jpg';
import productInnerPeace from '../assets/product-inner-peace.jpg';
import galleryFaithSeries from '../assets/gallery-faith-series.jpg';
import galleryCustomOrders from '../assets/gallery-custom-orders.jpg';
import galleryPremiumRange from '../assets/gallery-premium-range.jpg';
import gallerySpecialEditions from '../assets/gallery-special-editions.jpg';
import galleryGiftSets from '../assets/gallery-gift-sets.jpg';

const productImages = [
{
src: productFaithInspiration.src,
alt: "Bible Verse Wall Art - Philippians 4:8",
title: "Faith & Inspiration"
},
{
src: productDivineLove.src,
alt: "Love Scripture Display",
title: "Divine Love"
},
{
src: productGracePlaque.src,
alt: "Grace Scripture Plaque",
title: "Grace"
},
{
src: productInnerPeace.src,
alt: "Peace Scripture Diamond",
title: "Inner Peace"
}
];

const galleryImages = [
{ src: galleryFaithSeries.src, alt: "Faith Collection", title: "Faith Series" },
{ src: galleryCustomOrders.src, alt: "Custom Pieces", title: "Custom Orders" },
{ src: galleryPremiumRange.src, alt: "Premium Collection", title: "Premium Range" },
{ src: gallerySpecialEditions.src, alt: "Special Editions", title: "Special Editions" },
{ src: galleryGiftSets.src, alt: "Gift Packages", title: "Gift Sets" },
{ src: productInnerPeace.src, alt: "Limited Edition", title: "Limited Series" }
];

const testimonials = [
{
name: "Sarah Johnson",
role: "Customer from California",
image: productFaithInspiration.src,
content: "The quality and attention to detail are exceptional. I gave one as a gift and they absolutely loved it. Every piece feels like a work of art.",
rating: 5
},
{
name: "Michael Chen",
role: "Church Gift Coordinator",
image: productDivineLove.src,
content: "We've ordered multiple pieces for our congregation. The craftsmanship is outstanding and the spiritual messages are truly inspiring.",
rating: 5
},
{
name: "Emma Rodriguez",
role: "Interior Designer",
image: productGracePlaque.src,
content: "Perfect addition to my designs. My clients are always asking where these beautiful pieces come from. Koseli Crafts is a gem!",
rating: 5
}
];

const processSteps = [
{ icon: "✍", title: "Design & Concept", description: "We start with your vision, creating custom designs that capture the spiritual essence you desire." },
{ icon: "🔥", title: "Laser Engraving", description: "Precision laser technology engraves your design onto premium wood with exceptional detail." },
{ icon: "🎨", title: "Handicraft Details", description: "Our artisans hand-finish each piece, adding unique touches and embellishments." },
{ icon: "✨", title: "Quality Check & Finish", description: "Every piece is carefully inspected to ensure perfection before shipment to your home." }
];

const faqs = [
{
question: "What materials do you use?",
answer: "We use premium quality wood sourced responsibly. Each piece is selected for its natural beauty and durability. The engravings are done using precision laser technology, and all finishes are eco-friendly."
},
{
question: "Can I customize my order?",
answer: "Absolutely! We offer extensive customization options. You can choose different scriptures, add names, change dimensions, or work with us on a completely custom design. Contact us for details."
},
{
question: "What's your shipping timeline?",
answer: "Standard orders are typically processed within 5-7 business days. Custom orders take 10-14 business days. We ship worldwide with tracking and insurance included."
},
{
question: "Are your pieces suitable for gifts?",
answer: "Yes! Our pieces make excellent gifts for birthdays, anniversaries, spiritual milestones, and more. We offer beautiful gift packaging and can include personalized messages."
},
{
question: "How do I care for my piece?",
answer: "Simply dust with a soft cloth occasionally. Avoid direct sunlight for extended periods to maintain the wood's natural color. Keep away from moisture and extreme temperature changes."
},
{
question: "Do you have a return policy?",
answer: "Yes, we offer 30-day returns for unused items in original condition. Custom orders are final sale. For damaged items, we provide replacement or refund."
}
];
---

<Layout>
<div class="site-shell">
	<Navbar />
	<FeaturedSection images={productImages} />
	<HeroSection />
	<ProductsSection images={productImages} />
	<WhyChooseSection />
	<ProcessSection steps={processSteps} />
	<GallerySection images={galleryImages} />
	<TestimonialsSection testimonials={testimonials} />
	<FaqSection faqs={faqs} />
	<NewsletterSection />
	<ContactSection />
	<FinalCtaSection />
	<SiteFooter />
</div>
</Layout>
