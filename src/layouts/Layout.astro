---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import { WOOD } from '../data/decor';
import { FIRST_THEME } from '../lib/themes';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Koseli Crafts · Handmade gifts from Kathmandu',
	description = 'Engraved wooden gifts and macramé wall hangings, made by hand in Kathmandu, Nepal. Scripture in Nepali and English, and custom engraving. Order on WhatsApp.'
} = Astro.props;
---

<!doctype html>
<html lang="en" style={{ '--theme-bg': FIRST_THEME.background, '--wood-disc': `url(${WOOD.disc})` }}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Anek+Devanagari:wght@500;800&family=Tiro+Devanagari+Hindi&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
		<script>
			import initSiteMotion from '../scripts/site-motion';

			initSiteMotion();
		</script>
	</body>
</html>
