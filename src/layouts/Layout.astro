---
import '../styles/global.css';
import 'aos/dist/aos.css';
import 'lenis/dist/lenis.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Koseli Crafts · Handmade gifts from Kathmandu</title>
		<meta name="description" content="Engraved wooden gifts and macramé wall hangings, made by hand in Kathmandu, Nepal. Scripture in Nepali and English, and custom engraving. Order on WhatsApp." />
	</head>
	<body class="bg-snow text-pine antialiased">
		<slot />
		<script>
			import initSiteMotion from '../scripts/site-motion';

			initSiteMotion();
		</script>
	</body>
</html>
